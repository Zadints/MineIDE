<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<?import javafx.scene.layout.Pane?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.mineide.presentation.controllers.MainPageController"
            styleClass="main-page">

    <VBox spacing="35.0"
          alignment="TOP_CENTER"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">

        <padding>
            <Insets top="55.0"
                    right="70.0"
                    bottom="45.0"
                    left="70.0"/>
        </padding>

        <!-- HEADER -->

        <VBox fx:id="header"
                spacing="8.0"
              alignment="CENTER">

            <HBox spacing="12.0"
                  alignment="CENTER">

                <!-- TU LOGO SVG -->

                <SVGPath
                        content="M2.2,5.4 C2.2,-.04 6.05,.6 11.9,.6 C14.94,.6 22.17,.19 24.1,2.1 C25.89,3.86 23.39,7.84 23.2,7.9 C22.87,8.01 19.23,7.89 19.1,7.7 C15.12,1.78 10.06,4.71 8.5,6.1 C3.94,10.15 7.69,15.74 11.3,17.1 C15.11,18.54 18.97,14.48 19,11.7 C19,11.41 22.73,11.36 22.7,11.6 C21.57,19.66 13.65,24.21 13.6,24.2 C8.45,22.8 2.2,10.84 2.2,5.4z M10.3,10.7 C10.3,9.15 11.69,7.9 13.4,7.9 C15.11,7.9 16.5,9.15 16.5,10.7 C16.5,12.25 15.11,13.5 13.4,13.5 C11.69,13.5 10.3,12.25 10.3,10.7z"
                        scaleX="1.2"
                        scaleY="1.2"
                        styleClass="mineide-logo"/>

                <Label text="MineIDE"
                       styleClass="app-name"/>
            </HBox>

            <Label text="Minecraft Development Environment"
                   styleClass="app-subtitle"/>

            <Label text="v1.0.0"
                   styleClass="app-version"/>

        </VBox>


        <!-- MAIN ACTIONS -->

        <HBox spacing="20.0"
              alignment="CENTER"
              maxWidth="900.0">

            <!-- CREATE PROJECT -->

            <VBox spacing="12.0"
                  alignment="CENTER_LEFT"
                  styleClass="action-card"
                  HBox.hgrow="ALWAYS">

                <Label text="Create New Project"
                       styleClass="action-title"/>

                <Label text="Start a new Minecraft project"
                       styleClass="action-description"
                       wrapText="true"/>

                <Button text="Create Project"
                        fx:id="btnCreateProject"
                        onAction="#onCreateProject"
                        styleClass="primary-button"/>

            </VBox>


            <!-- OPEN FOLDER -->

            <VBox spacing="12.0"
                  alignment="CENTER_LEFT"
                  styleClass="action-card"
                  HBox.hgrow="ALWAYS">

                <Label text="Open Folder"
                       styleClass="action-title"/>

                <Label text="Open an existing Minecraft project"
                       styleClass="action-description"
                       wrapText="true"/>

                <Button text="Open Folder"
                        fx:id="btnOpenFolder"
                        onAction="#onOpenFolder"
                        styleClass="secondary-button"/>

            </VBox>


            <!-- SFTP -->

            <VBox spacing="12.0"
                  alignment="CENTER_LEFT"
                  styleClass="action-card"
                  HBox.hgrow="ALWAYS">

                <Label text="Connect via SFTP"
                       styleClass="action-title"/>

                <Label text="Connect to a remote Minecraft server"
                       styleClass="action-description"
                       wrapText="true"/>

                <Button text="Connect"
                        fx:id="btnConnectSftp"
                        onAction="#onConnectSftp"
                        styleClass="secondary-button"/>

            </VBox>

        </HBox>


        <!-- RECENT PROJECTS -->

        <VBox spacing="12.0"
              maxWidth="900.0"
              VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT">

                <Label text="Recent Projects"
                       styleClass="section-title"/>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="Clear Recent Projects"
                        fx:id="btnClearRecent"
                        onAction="#onClearRecent"
                        styleClass="text-button"/>

            </HBox>


            <ListView fx:id="recentProjectsList"
                      VBox.vgrow="ALWAYS"
                      prefHeight="180.0"
                      styleClass="recent-projects"/>

        </VBox>


        <!-- FOOTER -->

        <HBox maxWidth="900.0"
              alignment="CENTER_LEFT">

            <Button text="Plugins"
                    fx:id="btnPlugins"
                    onAction="#onPlugins"
                    styleClass="footer-button"/>

            <Button text="Settings"
                    fx:id="btnSettings"
                    onAction="#onSettings"
                    styleClass="footer-button"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label text="MineIDE • Minecraft Development"
                   styleClass="footer-text"/>

        </HBox>

    </VBox>
    <HBox alignment="TOP_LEFT"
          maxWidth="Infinity">

        <Button fx:id="btnClose"
                text="×"
                onAction="#onClose"
                styleClass="close-button"/>

    </HBox>
</AnchorPane>